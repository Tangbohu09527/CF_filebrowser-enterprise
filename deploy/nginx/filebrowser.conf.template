limit_req_zone $binary_remote_addr zone=filebrowser_auth:10m rate=${AUTH_RATE};
limit_req_zone $server_name zone=filebrowser_auth_global:1m rate=${AUTH_GLOBAL_RATE};

upstream filebrowser_backend {
    zone filebrowser_backend 64k;
    server filebrowser-enterprise:8080;
    keepalive 32;
}

server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    return 308 https://$host$request_uri;
}

server {
    listen 8443 ssl default_server;
    server_name ${PUBLIC_HOST};

    if ($host != ${PUBLIC_HOST}) { return 444; }
    if ($http_depth ~* "^[[:space:]]*infinity[[:space:]]*$") { return 403; }

    ssl_certificate ${TLS_CERT_CONTAINER_PATH};
    ssl_certificate_key ${TLS_KEY_CONTAINER_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    client_max_body_size ${MAX_UPLOAD_SIZE};
    client_body_timeout ${CLIENT_BODY_TIMEOUT};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    location = /nginx-health {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        access_log off;
        return 204;
    }

    location = /health {
        deny all;
        access_log off;
    }

    location ^~ /api/auth/ {
        limit_req zone=filebrowser_auth burst=${AUTH_BURST} nodelay;
        limit_req zone=filebrowser_auth_global burst=${AUTH_GLOBAL_BURST} nodelay;
        limit_req_status 429;
        proxy_pass http://filebrowser_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Auth-Request-User "";
        proxy_set_header Remote-User "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
        proxy_cookie_flags ~ secure httponly samesite=strict;
        proxy_hide_header Server;
    }

    location / {
        proxy_pass http://filebrowser_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Auth-Request-User "";
        proxy_set_header Remote-User "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
        proxy_cookie_flags ~ secure httponly samesite=strict;
        proxy_hide_header Server;
    }
}
